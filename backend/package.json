{
  "name": "grammarpath-backend",
  "version": "1.0.0",
  "description": "GrammarPath Express + TypeScript REST API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "test:migrations": "tsx scripts/verify-migrations.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/phase1-security-hardening.test.ts tests/phase1-6-hygiene.test.ts tests/phase1-7-staging-guard.test.ts tests/phase2-1-unit.test.ts tests/phase2-2-unit.test.ts",
    "staging:check": "node scripts/run-with-staging-env.mjs --check-only",
    "prisma:status:staging": "node scripts/run-with-staging-env.mjs -- ./node_modules/.bin/prisma migrate status",
    "prisma:migrate:staging": "node scripts/run-with-staging-env.mjs -- ./node_modules/.bin/prisma migrate deploy",
    "test:api:staging": "node scripts/run-with-staging-env.mjs -- ./node_modules/.bin/vitest run tests/curriculum.api.test.ts tests/exercises.api.test.ts tests/grading.api.test.ts tests/auth-and-progress.api.test.ts tests/adaptive.api.test.ts tests/adaptive-toeic.api.test.ts tests/phase2-1-remediation.api.test.ts tests/phase2-2-qa.api.test.ts",
    "start:staging": "node scripts/run-with-staging-env.mjs -- node dist/src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
