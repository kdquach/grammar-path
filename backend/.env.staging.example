# GrammarPath Backend — Isolated Staging Environment Template
# =============================================================================
# SAFETY RULES:
# 1. Copy this file to `backend/.env.staging` (gitignored; NEVER commit real secrets).
# 2. NEVER point DATABASE_URL / DIRECT_URL / POOLED_DATABASE_URL at production Neon.
# 3. NEVER copy or reuse production JWT_SECRET, GEMINI_API_KEY, or database credentials.
# 4. Change STAGING_ISOLATED_CONFIRMED="true" ONLY after verifying this points to an
#    isolated empty/disposable staging PostgreSQL database (dedicated Neon staging project
#    or local PostgreSQL instance).
# =============================================================================

STAGING_ISOLATED_CONFIRMED="false"

# Use "test" when executing API integration suites; use "production" when verifying compiled `node dist/src/server.js`.
NODE_ENV="test"
PORT=4100

# Dedicated staging PostgreSQL connection strings (placeholders only)
# Remote Neon example: postgresql://STAGING_USER:STAGING_PASSWORD@ep-staging-example.us-east-2.aws.neon.tech/grammarpath_staging?sslmode=require
# Local Docker/Homebrew example: postgresql://grammarpath_staging:STAGING_PASSWORD@localhost:5432/grammarpath_staging?schema=public
DATABASE_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/grammarpath_staging?sslmode=require"
DIRECT_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/grammarpath_staging?sslmode=require"
POOLED_DATABASE_URL="postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_POOLER_HOST:5432/grammarpath_staging?sslmode=require"

# Required: Generate a staging-only >=32 char high-entropy secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_STAGING_ONLY_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# Comma-separated explicit origins (never wildcard '*')
CORS_ORIGIN="http://localhost:5173"
BODY_LIMIT="100kb"

# Explicit proxy topology ("false"/"0" direct; "1" single proxy; "2" CDN + proxy)
TRUST_PROXY="false"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AI_MAX=20

# AI Configuration
# Leave GEMINI_API_KEY="" to verify fail-closed 503 AI_PROVIDER_UNAVAILABLE without external AI calls/spend.
# Populate ONLY with a staging-scoped key if testing live Gemini responses in adaptive.api.test.ts.
GEMINI_API_KEY=""
GEMINI_MODEL=""

