NODE_ENV="development"
PORT=4000
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"
POOLED_DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"

# Required: Generate a 32+ char high-entropy secret, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Comma-separated explicit origins (never use *). Dev defaults to http://localhost:5173
CORS_ORIGIN="http://localhost:5173"
BODY_LIMIT="100kb"

# Reverse proxy trust hop count (never uses permissive Express boolean `true`):
#   "false" or "0" -> direct traffic / local dev without proxy (ignores X-Forwarded-For)
#   "1"            -> single trusted edge proxy (e.g., Nginx, AWS ALB, Render, Railway, Fly)
#   "2"            -> two trusted proxies in series (e.g., Cloudflare CDN -> Nginx/ALB -> Node)
# Note: Rate limiting uses in-process MemoryStore (single-instance only; not shared across replicas).
TRUST_PROXY="false"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AI_MAX=20

# AI Configuration (Required for live AI theory explanations; optional TOEIC AI mode)
GEMINI_API_KEY=""
GEMINI_MODEL=""
